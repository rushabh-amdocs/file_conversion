      <zone size="2" type="A" name="X500-SOP-OCC-STATE-CODE" />
      <zone size="1" type="A" name="X500-SOP-OCC-ASSOC-TN-IND" />
      <group name="X500-SOP-OCC-ASSOC-TEL-NUM" >
