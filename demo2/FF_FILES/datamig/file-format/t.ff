      </group>
      <zone size="1" type="A" name="X500-SOP-OCC-SALES-TAX-IND" />
      <zone size="3" type="PS" allow-blanks="yes" allow-blanks="yes" allow-blanks="yes" name="X500-SOP-OCC-QUANTITY" />
      <zone size="9" type="NSE" allow-blanks="yes" allow-blanks="yes" allow-blanks="yes" decimals="2" name="X500-SOP-OCC-MONEY" />
      <zone size="5" type="PS" allow-blanks="yes" allow-blanks="yes" allow-blanks="yes" name="X500-SOP-OCC-THRU-DATE" />
      <zone size="1" type="A" name="X500-SOP-OCC-RT-CHG-PRT-IND" />
      <zone size="1" type="A" name="X500-SOP-OCC-UNDER-BOND-IND" />
      <zone size="1" type="A" name="X500-SOP-OCC-MEANS-SHPMT-IND" />
      <zone size="3" type="A" name="X500-SOP-OCC-SERVICE-CODE" />
      <zone size="1" type="A" name="X500-SOP-OCC-ZTIW" />
      <zone size="6" type="A" name="X500-SOP-OCC-HRS-USAGE-NETWORK" />
      <zone size="5" type="A" name="X500-SOP-OCC-HRS-USAGE-MACHINE" />
      <zone size="3" type="A" name="X500-SOP-OCC-LOB-IND" />
      <zone size="6" type="A" name="X500-SOP-OCC-SALES-RC" />
      <zone size="6" type="A" name="X500-SOP-OCC-SERVICE-RC" />
