  <record-format name="GSAM-FILE-X500-RECORD">
    <condition>
      <test>
        <ge offset="38" size ="3" type="A" />
          <value>500</value>
        </test>
        <test>
          <le offset="38" size ="3" type="A" />
        <value>599</value>
      </test>
    </condition>  
    <group name="X500-RECORD-PREFIX" >
      <zone size="2" type="I" name="X500-SOP-PREFIX-RECORD-LENGTH" />
      <group name="X500-SOP-PREFIX-ACCT-TEL-NUM" >
        <zone size="3" type="A" name="X500-SOP-PREFIX-NPA" />
