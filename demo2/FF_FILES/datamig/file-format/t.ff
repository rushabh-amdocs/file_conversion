  <record-format name="SOUP-FILE-X999-RECORD">
    <condition>
      <test>
        <eq offset="38" size ="3" type="A" />
        <value>999</value>
      </test>
    </condition>  
    <group name="X999-RECORD-FILE-HEADER" >
      <zone size="2" type="I" name="X999-SOP-F-HDR-REC-LENGTH" />
      <zone size="13" type="A" name="X999-SOP-F-HDR-SORT-SEQ-A" />
      <zone size="5" type="PS" allow-blanks="yes" allow-blanks="yes" allow-blanks="yes" name="X999-SOP-F-HDR-CUR-DATE" />
      <zone size="1" type="A" name="X999-SOP-F-HDR-LOW-VALUE" />
      <zone size="2" type="A" name="X999-SOP-F-HDR-YEAR" />
      <zone size="4" type="A" name="X999-SOP-F-HDR-CRIS-CYCLE" />
      <zone size="10" type="A" name="X999-SOP-F-HDR-SORT-SEQ-B" />
      <zone size="1" type="A" name="X999-SOP-F-HDR-SITE-CODE" />
      <zone size="4" type="A" name="X999-SOP-F-HDR-REC-TYPE" />
      <zone size="4" type="PS" allow-blanks="yes" allow-blanks="yes" allow-blanks="yes" name="X999-SOP-F-HDR-1ST-SOCS-CYCLE" />
      <zone size="4" type="PS" allow-blanks="yes" allow-blanks="yes" allow-blanks="yes" name="X999-SOP-F-HDR-LAST-SOCS-CYCLE" />
    </group>
  </record-format>
</file-format>

