flowchart LR
    subgraph Old["❌ OLD APPROACH - Manual Scripts"]
        direction TB
        O1["Multiple Terminal Windows"]
        O2["9+ Separate Script Files"]
        O3["Manual Configuration Editing"]
        O4["Command-Line Expertise Required"]
        O5["No Error Validation"]
        O6["Manual File Management"]
