    classDef oldStyle fill:#dc2626,stroke:#991b1b,stroke-width:2px,color:#fff
    classDef newStyle fill:#059669,stroke:#047857,stroke-width:2px,color:#fff
    classDef benefitStyle fill:#2563eb,stroke:#1e40af,stroke-width:3px,color:#fff
    
    class O1,O2,O3,O4,O5,O6,O7,O8,O9 oldStyle
    class N1,N2,N3,N4,N5,N6,N7,N8,N9 newStyle
    class B1,B2,B3,B4,B5,B6,B7,B8 benefitStyle
