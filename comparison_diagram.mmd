    subgraph New["✅ NEW APPROACH - Web UI Applications"]
        direction TB
        N1["Single Web Browser Interface"]
        N2["2 Unified Applications"]
        N3["Web-Based Configuration"]
        N4["Point-and-Click Operations"]
